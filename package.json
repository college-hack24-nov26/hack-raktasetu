{
  "name": "raktasetu-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@raktasetu/web",
    "dev:api": "npm run dev --workspace=@raktasetu/api",
    "dev:mobile": "npm run start --workspace=@raktasetu/mobile",
    "android:mobile": "npm run android --workspace=@raktasetu/mobile",
    "prebuild:mobile": "npm run prebuild --workspace=@raktasetu/mobile",
    "build:web": "npm run build --workspace=@raktasetu/web",
    "build:api": "npm run build --workspace=@raktasetu/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "seed:demo": "npm run seed:demo --workspace=@raktasetu/api",
    "cleanup:demo": "npm run cleanup:demo --workspace=@raktasetu/api",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "expo": "~52.0.49",
    "react": "18.3.1",
    "react-native": "0.76.9"
  }
}
