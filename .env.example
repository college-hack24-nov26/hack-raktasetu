# Application Environment
NODE_ENV=development
PORT=4000
WEB_ORIGIN="http://localhost:3000"

# Neon PostgreSQL Database Connections
# Runtime pooled connection (Neon pooler)
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.region.neon.tech/neondb?sslmode=require"
# Direct connection for Prisma migrations
DIRECT_URL="postgresql://user:password@ep-xyz-pooler.region.neon.tech/neondb?sslmode=require"

# Phase 3 Demo Authentication (Disabled by default in production)
DEMO_OTP="123456"
ALLOW_DEMO_OTP="true"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# e-RaktKosh Integration Base URL
ERAKTKOSH_BASE_URL="https://eraktkosh.mohfw.gov.in/eraktkoshPortal/eraktkosh"

# Mapbox Configuration (for interactive blood centre maps)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
MAPBOX_ACCESS_TOKEN=

# Optional WhatsApp Integration (Reserved for future phase - do not populate for demo)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
