    User {
        string id PK
        string phoneNumber UK
        string name
        enum role
        enum status
        datetime createdAt
    }

    BloodRequest {
        string id PK
        string requesterUserId FK
        string bloodGroup
        string component
        int units
        string urgency
        string hospitalCode FK
        string hospitalName
        string status
        string message "JSONB: routing & matching state"
        int allocatedUnits
    }

    Organisation {
        string id PK
        string orgCode UK
        string name
        enum orgType
        enum status
        int stateCode
        int districtCode
    }

    DonorProfile {
        string id PK
        string userId FK
        string bloodGroup
        boolean isAvailable
        boolean consentToContact
        int completedDonationsCount
        datetime lastDonationDate
    }

    CollectionUnit {
        string id PK
        string unitNumber UK
        string donationEventId FK
        string bloodGroup
        int volumeMl
        enum status
    }

    ComponentUnit {
        string id PK
        string componentCode UK
        string collectionUnitId FK
        enum componentType
        string bloodGroup
        enum status
        datetime expiresAt
    }

